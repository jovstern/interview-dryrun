{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(bash .claude/skills/:*)",
      "Bash(bash /Users/yoav/.claude/plugins/cache/claude-plugins-official/superpowers/:*)",
      "Read(/Users/yoav/.claude/plugins/cache/claude-plugins-official/superpowers/**)",
      "WebFetch(domain:nextjs.org)",
      "Bash(git push:*)",
      "Bash(git switch:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(gh pr:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api repos/jovstern/interview-task/:*)",
      "Bash(ffmpeg:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
